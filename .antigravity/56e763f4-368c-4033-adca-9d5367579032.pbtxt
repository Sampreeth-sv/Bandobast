            }
            lines {
              text: "| **PWA Compliance** | Web app & installable app at the same time with manifest, SW, & icons | `manifest.json` & `sw.js` |"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "---"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "## 6. Local Setup & Running Instructions"
