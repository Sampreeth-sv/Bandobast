  code_action {
    action_spec {
      create_file {
        instruction: "import { VendorQuote } from \'../types\';\n\nexport interface ExtractQuoteParams {\n  rawText?: string;\n  fileBase64?: string;\n  mimeType?: string;\n  vendorNameHint?: string;\n}\n\nexport interface VendorQuestionParams {\n  vendorName: string;\n  category: string;\n  missingFields: string[];\n  language?: \'English\' | \'Hindi\' | \'Gujarati\';\n  context?: string;\n}\n\n/**\n * Extract structured quotation using backend Gemini API or deterministic fallback\n */\nexport async function extractVendorQuote(params: ExtractQuoteParams): Promise<{\n  success: boolean;\n  source: \'gemini_extracted\' | \'deterministic_fallback\';\n  warning?: string;\n  data: Partial<VendorQuote>;\n}> {\n  try {\n    const res = await fetch(\'/api/quote/extract\', {\n      method: \'POST\',\n      headers: { \'Content-Type\': \'application/json\' },\n      body: JSON.stringify(params)\n    });\n\n    if (!res.ok) {\n      throw new Error(`Server returned HTTP ${res.status}`);\n    }\n\n    const json = await res.json();\n    return json;\n  } catch (error: any) {\n    console.warn(\'Backend quote extraction call failed, using client-side deterministic fallback:\', error);\n    \n    // Client-side fallback for offline/isolated demo execution\n    return {\n      success: true,\n      source: \'deterministic_fallback\',\n      warning: \'Processed via client fallback mode (Gemini proxy offline or demo active).\',\n      data: {\n        vendorName: params.vendorNameHint || \'Utsav Mandap & Grand Florals\',\n        vendorCategory: \'Decoration\',\n        quoteDate: new Date().toISOString().split(\'T\')[0],\n        totalAmount: 52000,\n        subtotal: 48000,\n        gstAmount: 4000,\n        serviceCharges: 0,\n        validityPeriod: \'Valid for 15 days\',\n        paymentTerms: \'50% advance booking deposit, 50% on morning of setup\',\n        cancellationPolicy: \'Deposit non-refundable if cancelled less than 14 days prior\',\n        inclusions: [\n          \'Vedic floral mandap with fresh yellow & orange marigolds\',\n          \'Sangeet stage backdrop with fairy light curtains and seating\',\n          \'Entrance welcome arch with fragrant tuberose (rajnigandha)\'\n        ],\n        exclusions: [\n          \'Power generator fuel during nighttime lighting\',\n          \'Post-event petal disposal and municipal cleaning\'\n        ],\n        missingFields: [\n          \'Rain protection canopy cost not mentioned \342\200\224 ask vendor\',\n          \'Exact setup completion time benchmark not stated \342\200\224 ask vendor\',\n          \'Breakage and damage security deposit terms omitted \342\200\224 ask vendor\'\n        ],\n        lineItems: [\n          {\n            id: \'cli-1\',\n            description: \'4-Pillar Heritage Floral Mandap & Carpet\',\n            quantity: 1,\n            unitPrice: 30000,\n            subtotal: 30000\n          },\n          {\n            id: \'cli-2\',\n            description: \'Sangeet Stage Lighting & Ambient Fairy Curtain\',\n            quantity: 1,\n            unitPrice: 18000,\n            subtotal: 18000\n          }\n        ]\n      }\n    };\n  }\n}\n\n/**\n * Generate vendor follow-up clarification questions in English, Hindi, or Gujarati\n */\nexport async function generateVendorQuestions(params: VendorQuestionParams): Promise<{\n  success: boolean;\n  source: string;\n  draft: string;\n}> {\n  try {\n    const res = await fetch(\'/api/quote/vendor-questions\', {\n      method: \'POST\',\n      headers: { \'Content-Type\': \'application/json\' },\n      body: JSON.stringify(params)\n    });\n\n    if (!res.ok) {\n      throw new Error(`Server returned HTTP ${res.status}`);\n    }\n\n    return await res.json();\n  } catch (error) {\n    console.warn(\'Backend question drafting failed, using client fallback:\', error);\n\n    const lang = params.language || \'English\';\n    let draft = \'\';\n\n    if (lang === \'Hindi\') {\n      draft = `\340\244\250\340\244\256\340\244\270\340\245\215\340\244\244\340\245\207 ${params.vendorName},\\n\\n\340\244\206\340\244\252\340\244\225\340\245\207 \340\244\255\340\245\207\340\244\234\340\245\207 \340\244\227\340\244\217 \340\244\225\340\245\213\340\244\237\340\245\207\340\244\266\340\244\250 \340\244\225\340\245\207 \340\244\262\340\244\277\340\244\217 \340\244\247\340\244\250\340\245\215\340\244\257\340\244\265\340\244\276\340\244\246\340\245\244 \340\244\271\340\244\256\340\244\276\340\244\260\340\245\207 \340\244\206\340\244\257\340\245\213\340\244\234\340\244\250 \340\244\225\340\245\207 \340\244\262\340\244\277\340\244\217 \340\244\250\340\244\277\340\244\256\340\245\215\340\244\250\340\244\262\340\244\277\340\244\226\340\244\277\340\244\244 \340\244\206\340\244\265\340\244\266\340\245\215\340\244\257\340\244\225 \340\244\254\340\244\277\340\244\202\340\244\246\340\245\201\340\244\223\340\244\202 \340\244\252\340\244\260 \340\244\270\340\245\215\340\244\252\340\244\267\340\245\215\340\244\237\340\244\244\340\244\276 \340\244\225\340\245\200 \340\244\206\340\244\265\340\244\266\340\245\215\340\244\257\340\244\225\340\244\244\340\244\276 \340\244\271\340\245\210:\\n\\n` +\n        params.missingFields.map((f, i) => `${i + 1}. ${f.replace(\' \342\200\224 ask vendor\', \'\')}`).join(\'\\n\') +\n        `\\n\\n\340\244\225\340\245\203\340\244\252\340\244\257\340\244\276 \340\244\207\340\244\250 \340\244\254\340\244\277\340\244\202\340\244\246\340\245\201\340\244\223\340\244\202 \340\244\252\340\244\260 \340\244\234\340\244\262\340\245\215\340\244\246 \340\244\234\340\244\276\340\244\250\340\244\225\340\244\276\340\244\260\340\245\200 \340\244\246\340\245\207\340\244\202 \340\244\244\340\244\276\340\244\225\340\244\277 \340\244\271\340\244\256 \340\244\205\340\244\227\340\245\215\340\244\260\340\244\277\340\244\256 \340\244\254\340\245\201\340\244\225\340\244\277\340\244\202\340\244\227 \340\244\244\340\244\257 \340\244\225\340\244\260 \340\244\270\340\244\225\340\245\207\340\244\202\340\245\244\\n\\n\340\244\270\340\244\276\340\244\246\340\244\260,\\n\340\244\206\340\244\257\340\245\213\340\244\234\340\244\225 \340\244\252\340\244\260\340\244\277\340\244\265\340\244\276\340\244\260 (\340\244\254\340\244\202\340\244\246\340\245\213\340\244\254\340\244\270\340\245\215\340\244\244)`;\n    } else if (lang === \'Gujarati\') {\n      draft = `\340\252\250\340\252\256\340\252\270\340\253\215\340\252\244\340\253\207 ${params.vendorName},\\n\\n\340\252\244\340\252\256\340\252\276\340\252\260\340\252\276 \340\252\225\340\253\213\340\252\237\340\253\207\340\252\266\340\252\250 \340\252\254\340\252\246\340\252\262 \340\252\226\340\253\202\340\252\254 \340\252\226\340\253\202\340\252\254 \340\252\206\340\252\255\340\252\276\340\252\260. \340\252\252\340\253\215\340\252\260\340\252\270\340\252\202\340\252\227\340\252\250\340\252\276 \340\252\206\340\252\257\340\253\213\340\252\234\340\252\250 \340\252\256\340\252\276\340\252\237\340\253\207 \340\252\250\340\253\200\340\252\232\340\253\207\340\252\250\340\252\276 \340\252\256\340\253\201\340\252\246\340\253\215\340\252\246\340\252\276\340\252\223 \340\252\205\340\252\202\340\252\227\340\253\207 \340\252\270\340\253\215\340\252\252\340\252\267\340\253\215\340\252\237\340\252\244\340\252\276 \340\252\225\340\252\260\340\252\265\340\252\276 \340\252\265\340\252\277\340\252\250\340\252\202\340\252\244\340\253\200:\\n\\n` +\n        params.missingFields.map((f, i) => `${i + 1}. ${f.replace(\' \342\200\224 ask vendor\', \'\')}`).join(\'\\n\') +\n        `\\n\\n\340\252\225\340\253\203\340\252\252\340\252\276 \340\252\225\340\252\260\340\253\200 \340\252\206 \340\252\265\340\252\277\340\252\227\340\252\244\340\253\213 \340\252\234\340\252\243\340\252\276\340\252\265\340\252\266\340\253\213 \340\252\234\340\253\207\340\252\245\340\253\200 \340\252\205\340\252\256\340\253\207 \340\252\250\340\252\277\340\252\260\340\253\215\340\252\243\340\252\257 \340\252\262\340\252\210 \340\252\266\340\252\225\340\253\200\340\252\217.\\n\\n\340\252\206\340\252\255\340\252\276\340\252\260,\\n\340\252\206\340\252\257\340\253\213\340\252\234\340\252\225 \340\252\252\340\252\260\340\252\277\340\252\265\340\252\276\340\252\260 (\340\252\254\340\252\202\340\252\246\340\253\213\340\252\254\340\252\270\340\253\215\340\252\244)`;\n    } else {\n      draft = `Dear ${params.vendorName} Team,\\n\\nThank you for sharing your quotation for our upcoming celebration. To help us finalize our operational plan, could you please clarify the following missing details:\\n\\n` +\n        params.missingFields.map((f, i) => `${i + 1}. ${f.replace(\' \342\200\224 ask vendor\', \'\')}`).join(\'\\n\') +\n        `\\n\\nWe look forward to your confirmation so we can finalize the booking.\\n\\nWarm regards,\\nEvent Operations Coordinator (via Bandobast)`;\n    }\n\n    return {\n      success: true,\n      source: \'client_fallback\',\n      draft\n    };\n  }\n}\n"
        path {
          absolute_uri: "file:///src/services/aiService.ts"
        }
        overwrite: true
      }
