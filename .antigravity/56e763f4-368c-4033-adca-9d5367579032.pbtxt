      thinking_signature: "\022\313\f\n\310\f\001i\024}\023\000}\256\\\206\260\017\\\267\177\021t^\0264\343\362\3349\252\r\316~\r\313c\247?\022\354\215n\364\320\222E\241\006#\231\243\243\026\372I\0216\341\33478;\367JF\334\226u]\036\364\247\a#\3622\276\356\200OJ\304\366\345\351\vn.\205_P[Rs\362\264@\f\244L\fG(\034\356\364\330\036\364i;\300\b\244\006\002\3335H\006\370\020?\231\020\v9c\353\030\254\337\212\246\2475\t\245\022\266\335e\v\270\304\323\313\030k\352-P/\247\272d\374\326\001\004\244\203\001\220\270\231\fV\250+\202\314\0359\001}\273\037\376=\325B\f\231\035\374\365\200s3o\345\354\213\316F\006:Hj\252\352\365[1\023\237$q\254\206\355\2710\343\031\037\026\374\263\001d|\274x\336\r\235\200\254\354\311V\342l\350\226\236yvt\363\375\204\a\036\031n)\035\270\275\006\331\242\326R\267\330\370\234W\377\331\244%\305\344~\214\340t\027JaV\256s\243\bkv\217\262 \207A\307J\244|\036\021Y\003\023\3446O@\021\221/-\344\245v\023\377L\224\270FPo\310\224(\227\235\214?k\245J\200\232x\253\304\215\3773\306\344\020\350<$\332\2378\273vS\215\325o\315\362\3629B\026\210o\250\256\320z_\v@\264\232\3374\272\300k\254\"\261\357\241\344\340\234\335\'j\025[6v`t\215\340\323:\337^l\210\262\3661\344y\310\352e\002\".@K\344|\365a\334\253\t~\253\202.m\'\002\231\000n\034|\264\232,\246aJ\377.\t\324v[\341\020\231\300\300\032\255\264\252\177\203\212\241\271\'\311\312B@7\252*]\333RL\036\342\304\244\v\206\213\373\374\277\031\372qW%\261\b\265\037[\023\177Zd\244\254\271\222\316zeq\301\312\006\377\274\251C,\360\217lu\251\375\273\035\246V\322\272\365\355j\003e\r1\305\260\350O*\353\237\221\217|\320\266\244^\272\374\023\260\323@\277\226\317\005\251Awi\254$\n\2765\016\027\240\312\213\253\267uO\356\031\260y\333w:6\000}\017c\234\005:\345x|U.\3470\211sC\210\256f+\314\304Si_<\301\361\"/\032\"\022\267\320\227\256.j\370fU\227\356\225\256\025\372A?J\0366K^\026\005\231f\202\005\022\035\354\033af\030\373\343\334\253 \251u\\u\023\270b#n\237>\t\235\027[w\'.\365\316\351F2\322\337\305\317\331c\276/\225\375\227J\361s\254\241\216&?\n\353\362\335\376\360\215\344\026\206=\263\035sGY\377y\031M\274K\231f\340\375\251V\313z\f\356\346\320\351\376Y\270\006d&\204h\373n\031\037\r\204\320\020\b\217\024\325\005\304\f\\\343GJ\000\036\031b\346\230\243fv\036s\214\351-\032=\363%Kl}\024\234\036\037\352_n\000\031\312m~K0\"\224^\036e\330\351\246\36097\027\177\324j5\260M\027@\213\323M~\000\bfV\214\313\351E\367\342\367\"y$\251\366\300\236\262\2264\352O\374\321\to\237i\361S\246\377\325G\262O\232\301\260\356\0260\031\263K@\356\343\252\362\340\337\247\004\035DL\nPs\024||\004\303\230@v\202\333\360\264V\033\213qyj\a\316\320s\247\"o!J/\255\312U\000\364\343\227\336A\243\037j\357s|}\302\005}:\tFm\224\335\323\341\277\336L\220J\242\272\3733\367\217/\262\375\261]\016|\223\325\335l,f\312=6.\244|j\254~\257\373\024\\\005\340\334\370\255(\356\314\0319>\324.\334\263)\220\340\030\202\214\t.3\333\266j\350\205\356\262\306&\221\034\255\3125\277\264Oy\373\320\353\027\254\274\227\255\\\360\204U\226\354;\233\344\035s\216\017\217\2523\344\265a\036A\363\357\254\315\204\322\373\202\236\034\006\243\005\300\271\333\275z\216J{\361`d\271Ll\334U\002^\313\252\326\255\305\032a\315\207\321X\3227\017\213\214\\$\262\261d\326e\204\377\2310\300\201\321\215\026\223\277Y>\212;\344\304-\232W\020\025\032\265\355p\311p\365\335}\233\251k\256/\230\006\220\317\"\a\001\360\266+_%v=t\361\232\026C{\275\037\206P\037N\315U4PR\201\221W\311\257\212\333\017\356\031\005Q\277\271\223fo,\324\340\316\347\265\335l\260\220\340\334\031\3365\236\265\fCD*\273\372zdw\030b\340)\263f\324\335\331\a\270\360\002F\375\001\'nz%$\001\340\177/\327Vz#8\260\344\365\032\267\217\310b\241\276 \346\3300\335\215\302>r\300\303|0h\236\025\324\377\266\'>`#\336\371\365\034\354\373\2336\243\307S\345OJ\247(iS\324H\241\257\224\366\275\310\315<T\'\244\203T\345D\246\361\3708\301\234\261v\274~\314wyekk\245\017\036\356}\002\271]\263\201\177\247\022\022>\f\250\213\233\222y\357Q\357\202\207\271\350\236d\360z\317\347`\003@I\241\366nl\262\253\220\216;D\2649s\343kN\303\001+K\035\037=q!18\021\367\270\336\031\t\357e\325\214\264\204aY\352\366*\326\215Y\361\227\361\2454R\226L^\177\020\267\205O\016YC\212Q\3546\\w\024\200\226]\255\323vK\003p\016\2222\215\021[V\263\b\323q\311\210\354\313\241\261]\241%8g\243]\177\021\253\341\226\344.\352\277\200y\365\f\263I:\247\347$\363\253u\3451\020VT\304\250{\223\v,\333\216\274y\350\232\240\324\270\237&\253\234\316\360\366WE\255 \210]\222VRj!\227\376?\205\326\305OoG\304c\356\231.\\\336\323h\377\025\342\331\222\334j\216\257\324\244\216\375y\361Vz$\001\204\221\211@+\273-\236o\315~\211\373h/?\023g\303\242\255N!\360\277\216l\315S\003\025\323\003\005+\037f\353S\032 \364\342{\312\371\201\303Y.Ttb\251\326\021N\350\252\'{"
