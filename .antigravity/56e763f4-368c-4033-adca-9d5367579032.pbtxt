200 \340\252\205\340\252\256\340\253\207 \340\252\250\340\252\277\340\252\260\340\253\215\340\252\243\340\252\257 \340\252\262\340\252\210 \340\252\266\340\252\225\340\253\200\340\252\217.\\\\n\\\\n\340\252\206\340\252\255\340\252\276\340\252\260,\\\\n\340\252\206\340\252\257\340\253\213\340\252\234\340\252\225 \340\252\252\340\252\260\340\252\277\340\252\265\340\252\276\340\252\260 (\340\252\254\340\252\202\340\252\246\340\253\213\340\252\254\340\252\270\340\253\215\340\252\244)`;\\n    } else {\\n      draft = `Dear ${params.vendorName} Team,\\\\n\\\\nThank you for sharing your quotation for our upcoming celebration. To help us finalize our operational plan, could you please clarify the following missing details:\\\\n\\\\n` +\\n        params.missingFields.map((f, i) => `${i + 1}. ${f.replace(\' \342\200\224 ask vendor\', \'\')}`).join(\'\\\\n\') +\\n        `\\\\n\\\\nWe look forward to your confirmation so we can finalize the booking.\\\\n\\\\nWarm regards,\\\\nEvent Operations Coordinator (via Bandobast)`;\\n    }\\n\\n    return {\\n      success: true,\\n      source: \'client_fallback\',\\n      draft\\n    };\\n  }\\n}\\n\", \"Description\":\"Implement AI and Gemini integration service with robust multi-lingual fallbacks\", \"Overwrite\":true, \"TargetFile\":\"/src/services/aiService.ts\", \"toolAction\":\"Writing aiService.ts\", \"toolSummary\":\"Create aiService\"}"
