              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "| **Quote X-Ray & Omission Detection** | Identifies missing GST, overtime & drafting multilingual inquiries | `/api/quote/extract` & UI |"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "| **Data Provenance System** | Badges on line items: `quoted`, `user_entered`, `ai_estimate`, `illustrative` | `ProvenanceBadge.tsx` |"
