              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    const day = pad(d.getDate());"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    return `${y}${m}${day}T090000Z`;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
