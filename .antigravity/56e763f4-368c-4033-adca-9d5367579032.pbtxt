  planner_response {
    thinking: "**Importing and Organizing Views**\n\nI\'m now integrating `HomeHubView`, `AiChatView`, `ChatSession`, `ChatMessage`, and `VendorRecommendation` into `src/App.tsx`. The core focus is managing `chatSessions`. I\'m starting with pre-defined conversations, the first being \"Jaipur Heritage Wedding Strategy\" with a budget specified. I\'m focusing on data structuring now.\n\n\n"
    tool_calls {
      id: "call_737974"
      name: "write_to_file"
      arguments_json: "{\"CodeContent\":\"import React, { useState, useEffect } from \'react\';\\nimport { \\n  CelebrationEvent, \\n  RippleSimulationState, \\n  VendorQuote, \\n  ChatSession, \\n  ChatMessage, \\n  VendorRecommendation,\\n  BudgetLineItem\\n} from \'./types\';\\nimport { SAMPLE_WEDDING, SAMPLE_BIRTHDAY } from \'./data/sampleCelebration\';\\nimport { Sidebar, NavigationTab } from \'./components/Sidebar\';\\nimport { Header } from \'./components/Header\';\\nimport { PWAInstallBanner } from \'./components/PWAInstallBanner\';\\nimport { HomeHubView } from \'./components/HomeHubView\';\\nimport { AiChatView } from \'./components/AiChatView\';\\nimport { OverviewView } from \'./components/OverviewView\';\\nimport { BudgetStudioView } from \'./components/BudgetStudioView\';\\nimport { RippleEngineView } from \'./components/RippleEngineView\';\\nimport { VendorQuotesView } from \'./components/VendorQuotesView\';\\nimport { TimelineView } from \'./components/TimelineView\';\\nimport { PrioritiesView } from \'./components/PrioritiesView\';\\nimport { SimulateChangeModal } from \'./components/SimulateChangeModal\';\\nimport { TradeoffSimulatorModal } from \'./components/TradeoffSimulatorModal\';\\nimport { EventWizardModal } from \'./components/EventWizardModal\';\\nimport { calculateBudgetTotals, calculateEventReadiness } from \'./services/rippleEngine\';\\n\\nconst INITIAL_CHAT_SESSIONS: ChatSession[] = [\\n  {\\n    id: \'session-1\',\\n    title: \'Jaipur Heritage Wedding Strategy\',\\n    budget: 300000,\\n    createdAt: \'2026-10-24T10:00:00Z\',\\n    updatedAt: \'2026-10-25T14:00:00Z\',\\n    messages: [\\n      {\\n        id: \'msg-init-1\',\\n        role: \'user\',\\n        content: \'Hi Bandobast AI! We are organizing a 4-function wedding in Jaipur with 180 guests and a budget of \342\202\2713,00,000. How should we allocate this between venue, catering, and photography?\',\\n        timestamp: \'10:00 AM\',\\n        budgetContext: 300000\\n      },\\n      {\\n        id: \'msg-init-2\',\\n        role: \'assistant\',\\n        content: `Namaste! Planning a traditional celebration in Jaipur is wonderful. For a budget of \342\202\2713,00,000 and 180 guests, here is our recommended operational formula:\\n\\n\342\200\242 **Catering & Feasts (38% \342\200\224 \342\202\2711,14,000):** Gives approx \342\202\271630/guest across the main functions. This comfortably supports a rich regional buffet with live chaat and hot jalebi-rabdi.\\n\342\200\242 **Venues & Mandap Lawns (22% \342\200\224 \342\202\27166,000):** Covers a boutique heritage haveli or lawn with auspicious morning muhurat access.\\n\342\200\242 **Decoration & Floral Canopies (16% \342\200\224 \342\202\27148,000):** Focus on vibrant local yellow & orange marigolds with fairy light canopies.\\n\342\200\242 **Photography & Cinema (13% \342\200\224 \342\202\27139,000):** 2 candid photographers + 4K cinematic teaser film.\\n\342\200\242 **Contingency Buffer (11% \342\200\224 \342\202\27133,000):** Essential reserve for sudden plate increases or overtime.\\n\\nYou can ask me to recommend specific verified venues, caterers, or photographers, or adjust your budget anytime using the slider above!`,\\n        timestamp: \'10:01 AM\',\\n        budgetContext: 300000\\n      }\\n    ]\\n  },\\n  {\\n    id: \'session-2\',\\n    title: \'Food Catering & Live Counters Review\',\\n    budget: 300000,\\n    createdAt: \'2026-10-23T15:30:00Z\',\\n    updatedAt: \'2026-10-24T12:00:00Z\',\\n    messages: [\\n      {\\n        id: \'msg-c-1\',\\n        role: \'user\',\\n        content: \'What catering options can we get for around \342\202\271400 to \342\202\271500 per plate in Jaipur for 180 guests?\',\\n        timestamp: \'03:30 PM\',\\n        budgetContext: 300000\\n      },\\n      {\\n        id: \'msg-c-2\',\\n        role: \'assistant\',\\n        content: `At \342\202\271400-\342\202\271500/plate in Jaipur, you can book excellent royal vegetarian specialists such as **Royal Rasoi Gourmet Caterers** or **Annapurna Satvik Banquets**.\\n\\nThey typically include:\\n1. 3 Welcome beverages (Aam Panna, Badam Thandai, Masala Chaas)\\n2. Live Chaat counter (Pani Puri, Dahi Papdi, Aloo Tikki)\\n3. 3 Paneer & Dal preparations (Dal Baati Churma, Paneer Lababdar)\\n4. 2 Hot Desserts (Gulab Jamun, Moong Dal Halwa or Live Jalebi)\\n\\nWould you like me to add Royal Rasoi to your Event Budget Ledger?`,\\n        timestamp: \'03:31 PM\',\\n        budgetContext: 300000\\n      }\\n    ]\\n  }\\n];\\n\\nexport default function App() {\\n  // Available celebration events\\n  const [events, setEvents] = useState<CelebrationEvent[]>(() => {\\n    const saved = localStorage.getItem(\'bandobast_events\');\\n    if (saved) {\\n      try {\\n        return JSON.parse(saved);\\n      } catch (e) {\\n        console.error(\'Failed to parse saved events:\', e);\\n      }\\n    }\\n    return [SAMPLE_WEDDING, SAMPLE_BIRTHDAY];\\n  });\\n\\n  const [activeEventId, setActiveEventId] = useState<string>(SAMPLE_WEDDING.id);\\n  const [currentTab, setCurrentTab] = useState<NavigationTab>(\'home\'); // Opens on Home Page as requested!\\n  const [isMobileMenuOpen, setIsMobileMenuOpen] = useState(false);\\n\\n  // Chat sessions state\\n  const [chatSessions, setChatSessions] = useState<ChatSession[]>(() => {\\n    const savedChats = localStorage.getItem(\'bandobast_chats\');\\n    if (savedChats) {\\n      try {\\n        return JSON.parse(savedChats);\\n      } catch (e) {\\n        console.error(\'Failed to parse saved chats:\', e);\\n      }\\n    }\\n    return INITIAL_CHAT_SESSIONS;\\n  });\\n\\n  const [activeSessionId, setActiveSessionId] = useState<string>(INITIAL_CHAT_SESSIONS[0].id);\\n\\n  // Modals\\n  const [showSimulateModal, setShowSimulateModal] = useState(false);\\n  const [showTradeoffModal, setShowTradeoffModal] = useState(false);\\n  const [showNewEventModal, setShowNewEventModal] = useState(false);\\n\\n  // PWA deferred prompt\\n  const [deferredPrompt, setDeferredPrompt] = useState<any>(null);\\n  const [canInstallPwa, setCanInstallPwa] = useState(false);\\n\\n  // Read URL query params on load (e.g. for PWA shortcuts)\\n  useEffect(() => {\\n    const params = new URLSearchParams(window.location.search);\\n    const tabParam = params.get(\'tab\') as NavigationTab;\\n    if (tabParam && [\'home\', \'chat\', \'overview\', \'budget\', \'ripple\', \'quotes\', \'timeline\', \'priorities\'].includes(tabParam)) {\\n      setCurrentTab(tabParam);\\n    }\\n  }, []);\\n\\n  // Handle PWA install event\\n  useEffect(() => {\\n    const handleBeforeInstallPrompt = (e: Event) => {\\n      e.preventDefault();\\n      setDeferredPrompt(e);\\n      setCanInstallPwa(true);\\n    };\\n\\n    window.addEventListener(\'beforeinstallprompt\', handleBeforeInstallPrompt);\\n\\n    return () => {\\n      window.removeEventListener(\'beforeinstallprompt\', handleBeforeInstallPrompt);\\n    };\\n  }, []);\\n\\n  // Save events to localStorage\\n  useEffect(() => {\\n    localStorage.setItem(\'bandobast_events\', JSON.stringify(events));\\n  }, [events]);\\n\\n  // Save chats to localStorage\\n  useEffect(() => {\\n    localStorage.setItem(\'bandobast_chats\', JSON.stringify(chatSessions));\\n  }, [chatSessions]);\\n\\n  const activeEvent = events.find(e => e.id === activeEventId) || events[0] || SAMPLE_WEDDING;\\n  const budget = calculateBudgetTotals(activeEvent);\\n\\n  const handleUpdateCurrentEvent = (updated: CelebrationEvent) => {\\n    setEvents(prev => prev.map(e => e.id === updated.id ? updated : e));\\n  };\\n\\n  const handleSelectEvent = (eventId: string) => {\\n    setActiveEventId(eventId);\\n  };\\n\\n  const handleResetDemoData = () => {\\n    setEvents([\\n      JSON.parse(JSON.stringify(SAMPLE_WEDDING)),\\n      JSON.parse(JSON.stringify(SAMPLE_BIRTHDAY))\\n    ]);\\n    setChatSessions(INITIAL_CHAT_SESSIONS);\\n    setActiveEventId(SAMPLE_WEDDING.id);\\n    setActiveSessionId(INITIAL_CHAT_SESSIONS[0].id);\\n    setCurrentTab(\'home\');\\n  };\\n\\n  const handleApplySimulation = (simulation: RippleSimulationState) => {\\n    const updated: CelebrationEvent = {\\n      ...activeEvent,\\n      activeSimulation: simulation,\\n      updatedAt: new Date().toISOString()\\n    };\\n    handleUpdateCurrentEvent(updated);\\n    setCurrentTab(\'ripple\'); // Navigate to Ripple Engine to inspect consequences\\n  };\\n\\n  const handleAddQuoteToEvent = (quote: VendorQuote) => {\\n    const updated: CelebrationEvent = {\\n      ...activeEvent,\\n      quotes: [quote, ...activeEvent.quotes],\\n      updatedAt: new Date().toISOString()\\n    };\\n    handleUpdateCurrentEvent(updated);\\n  };\\n\\n  const handleEventCreated = (newEvent: CelebrationEvent) => {\\n    setEvents(prev => [newEvent, ...prev]);\\n    setActiveEventId(newEvent.id);\\n    setCurrentTab(\'overview\');\\n  };\\n\\n  const handleInstallPwa = async () => {\\n    if (deferredPrompt) {\\n      deferredPrompt.prompt();\\n      const { outcome } = await deferredPrompt.userChoice;\\n      if (outcome === \'accepted\') {\\n        setCanInstallPwa(false);\\n      }\\n    }\\n  };\\n\\n  // Chat management methods\\n  const handleStartNewChat = () => {\\n    const newSession: ChatSession = {\\n      id: `session-${Date.now()}`,\\n      title: `Celebration Plan & Ideas #${chatSessions.length + 1}`,\\n      budget: activeEvent.totalBudget,\\n      createdAt: new Date().toISOString(),\\n      updatedAt: new Date().toISOString(),\\n      messages: [\\n        {\\n          id: `msg-${Date.now()}`,\\n          role: \'assistant\',\\n          content: `Namaste! I am your Bandobast AI Advisor. We have your active celebration \\\"${activeEvent.name}\\\" configured with a budget of \342\202\271${activeEvent.totalBudget.toLocaleString(\'en-IN\')} for ${activeEvent.guestCount} guests in ${activeEvent.location}.\\n\\nHow can I assist today? You can:\\n1. Ask me to suggest top venues, caterers, or photographers for your budget.\\n2. Change the budget anytime using the slider at the top.\\n3. Ask how a date change or guest surge impacts your timeline.`,\\n          timestamp: new Date().toLocaleTimeString([], { hour: \'2-digit\', minute: \'2-digit\' }),\\n          budgetContext: activeEvent.totalBudget\\n        }\\n      ]\\n    };\\n\\n    setChatSessions(prev => [newSession, ...prev]);\\n    setActiveSessionId(newSession.id);\\n    setCurrentTab(\'chat\');\\n  };\\n\\n  const handleSelectChatSession = (sessionId: string) => {\\n    setActiveSessionId(sessionId);\\n    setCurrentTab(\'chat\');\\n  };\\n\\n  const handleUpdateSessionMessages = (sessionId: string, messages: ChatMessage[], newBudget?: number) => {\\n    setChatSessions(prev => prev.map(s => {\\n      if (s.id !== sessionId) return s;\\n      return {\\n        ...s,\\n        messages,\\n        budget: newBudget !== undefined ? newBudget : s.budget,\\n        updatedAt: new Date().toISOString()\\n      };\\n    }));\\n  };\\n\\n  // Sync budget from Chat or Home Page into the living event\\n  const handleUpdateEventBudget = (newBudget: number) => {\\n    if (newBudget <= 0) return;\\n\\n    // Scale category planned amounts proportionally to the new ceiling\\n    const oldBudget = activeEvent.totalBudget || 1;\\n    const ratio = newBudget / oldBudget;\\n\\n    const updatedCategories = activeEvent.categories.map(cat => ({\\n      ...cat,\\n      plannedAmount: Math.round(cat.plannedAmount * ratio),\\n      lineItems: (cat.lineItems || []).map(li => ({\\n        ...li,\\n        plannedAmount: Math.round(li.plannedAmount * ratio)\\n      }))\\n    }));\\n\\n    const updatedEvent: CelebrationEvent = {\\n      ...activeEvent,\\n      totalBudget: newBudget,\\n      contingencyReserve: Math.round(newBudget * 0.08),\\n      categories: updatedCategories,\\n      updatedAt: new Date().toISOString()\\n    };\\n\\n    updatedEvent.readinessScore = calculateEventReadiness(updatedEvent).score;\\n    handleUpdateCurrentEvent(updatedEvent);\\n  };\\n\\n  // 1-Click Add Recommended Vendor/Place directly to Event Ledger\\n  const handleAddVendorToLedger = (rec: VendorRecommendation) => {\\n    const targetCategoryId = \\n      rec.category === \'catering\' ? \'cat-catering\' :\\n      rec.category === \'venue\' ? \'cat-venue\' :\\n      rec.category === \'photography\' ? \'cat-photo\' : \'cat-decor\';\\n\\n    const newLineItem: BudgetLineItem = {\\n      id: `li-rec-${Date.now()}`,\\n      categoryId: targetCategoryId,\\n      name: `${rec.name} (${rec.priceRange})`,\\n      unitType: rec.category === \'catering\' ? \'per_guest\' : \'fixed\',\\n      unitCost: rec.category === \'catering\' ? Math.round(rec.estimatedCost / (activeEvent.guestCount || 180)) : undefined,\\n      quantity: rec.category === \'catering\' ? activeEvent.guestCount : 1,\\n      plannedAmount: rec.estimatedCost,\\n      committedAmount: 0,\\n      paidAmount: 0,\\n      isProtected: false,\\n      provenance: {\\n        source: \'ai_estimate\',\\n        calculationBasis: `Suggested by Gen AI Recommendation Engine based on \342\202\271${activeEvent.totalBudget.toLocaleString(\'en-IN\')} budget`,\\n        verified: true,\\n        lastUpdated: new Date().toISOString().split(\'T\')[0],\\n        notes: `Vendor contact: ${rec.contactName || \'Manager\'} (${rec.contactNumber || \'Available\'})`\\n      }\\n    };\\n\\n    const updatedCategories = activeEvent.categories.map(cat => {\\n      if (cat.id !== targetCategoryId) return cat;\\n      const currentItems = cat.lineItems || [];\\n      const updatedItems = [...currentItems, newLineItem];\\n      const sum = updatedItems.reduce((acc, item) => acc + item.plannedAmount, 0);\\n      return {\\n        ...cat,\\n        plannedAmount: sum,\\n        lineItems: updatedItems\\n      };\\n    });\\n\\n    const updatedEvent: CelebrationEvent = {\\n      ...activeEvent,\\n      categories: updatedCategories,\\n      updatedAt: new Date().toISOString()\\n    };\\n    updatedEvent.readinessScore = calculateEventReadiness(updatedEvent).score;\\n    handleUpdateCurrentEvent(updatedEvent);\\n  };\\n\\n  return (\\n    <div className=\\\"min-h-screen bg-[#FAF7F0] text-[#302F28] flex flex-col font-sans selection:bg-[#E7A83E]/25\\\">\\n      {/* PWA App Install Notification Banner */}\\n      <PWAInstallBanner\\n        deferredPrompt={deferredPrompt}\\n        onInstallSuccess={() => setCanInstallPwa(false)}\\n      />\\n\\n      <div className=\\\"flex-1 flex\\\">\\n        {/* Navigation Sidebar */}\\n        <Sidebar\\n          currentTab={currentTab}\\n          onSelectTab={setCurrentTab}\\n          isOpenMobile={isMobileMenuOpen}\\n          onCloseMobile={() => setIsMobileMenuOpen(false)}\\n          activeSimulationCount={activeEvent.activeSimulation.activePreset !== \'none\' ? 1 : 0}\\n        />\\n\\n        {/* Main Content Workspace */}\\n        <div className=\\\"flex-1 flex flex-col min-w-0 lg:pl-64\\\">\\n          {/* Header */}\\n          <Header\\n            currentEvent={activeEvent}\\n            availableEvents={events}\\n            onSelectEvent={handleSelectEvent}\\n            onOpenNewEventModal={() => setShowNewEventModal(true)}\\n            onOpenSimulateModal={() => setShowSimulateModal(true)}\\n            onResetDemoData={handleResetDemoData}\\n            onToggleMobileMenu={() => setIsMobileMenuOpen(!isMobileMenuOpen)}\\n            onInstallPwa={handleInstallPwa}\\n            canInstallPwa={canInstallPwa}\\n          />\\n\\n          {/* Dynamic Content Views */}\\n          <main className=\\\"flex-1 p-4 sm:p-6 lg:p-8 max-w-7xl mx-auto w-full\\\">\\n            {currentTab === \'home\' && (\\n              <HomeHubView\\n                currentEvent={activeEvent}\\n                chatSessions={chatSessions}\\n                onStartNewChat={handleStartNewChat}\\n                onSelectChatSession={handleSelectChatSession}\\n                onNavigateTab={setCurrentTab}\\n                onUpdateEventBudget={handleUpdateEventBudget}\\n                onAddVendorToLedger={handleAddVendorToLedger}\\n                onOpenSimulateModal={() => setShowSimulateModal(true)}\\n              />\\n            )}\\n\\n            {currentTab === \'chat\' && (\\n              <AiChatView\\n                currentEvent={activeEvent}\\n                chatSessions={chatSessions}\\n                activeSessionId={activeSessionId}\\n                onSelectSession={setActiveSessionId}\\n                onStartNewChat={handleStartNewChat}\\n                onUpdateSessionMessages={handleUpdateSessionMessages}\\n                onAddVendorToLedger={handleAddVendorToLedger}\\n                onSyncBudgetToEvent={handleUpdateEventBudget}\\n              />\\n            )}\\n\\n            {currentTab === \'overview\' && (\\n              <OverviewView\\n                event={activeEvent}\\n                onNavigateTab={setCurrentTab}\\n                onOpenSimulateModal={() => setShowSimulateModal(true)}\\n                onOpenTradeoffModal={() => setShowTradeoffModal(true)}\\n              />\\n            )}\\n\\n            {currentTab === \'budget\' && (\\n              <BudgetStudioView\\n                event={activeEvent}\\n                onUpdateEvent={handleUpdateCurrentEvent}\\n                onOpenTradeoffModal={() => setShowTradeoffModal(true)}\\n              />\\n            )}\\n\\n            {currentTab === \'ripple\' && (\\n              <RippleEngineView\\n                event={activeEvent}\\n                onUpdateSimulation={(sim) => {\\n                  const updated: CelebrationEvent = {\\n                    ...activeEvent,\\n                    activeSimulation: sim,\\n                    updatedAt: new Date().toISOString()\\n                  };\\n                  handleUpdateCurrentEvent(updated);\\n                }}\\n                onOpenTradeoffModal={() => setShowTradeoffModal(true)}\\n              />\\n            )}\\n\\n            {currentTab === \'quotes\' && (\\n              <VendorQuotesView\\n                event={activeEvent}\\n                onAddQuoteToEvent={handleAddQuoteToEvent}\\n              />\\n            )}\\n\\n            {currentTab === \'timeline\' && (\\n              <TimelineView\\n                event={activeEvent}\\n                onUpdateEvent={handleUpdateCurrentEvent}\\n              />\\n            )}\\n\\n            {currentTab === \'priorities\' && (\\n              <PrioritiesView\\n                event={activeEvent}\\n                onUpdateEvent={handleUpdateCurrentEvent}\\n                onOpenTradeoffModal={() => setShowTradeoffModal(true)}\\n              />\\n            )}\\n          </main>\\n        </div>\\n      </div>\\n\\n      {/* Modals */}\\n      {showSimulateModal && (\\n        <SimulateChangeModal\\n          event={activeEvent}\\n          currentSimulation={activeEvent.activeSimulation}\\n          onApplySimulation={handleApplySimulation}\\n          onClose={() => setShowSimulateModal(false)}\\n        />\\n      )}\\n\\n      {showTradeoffModal && (\\n        <TradeoffSimulatorModal\\n          event={activeEvent}\\n          overrunAmount={budget.overrunAmount}\\n          onApplyScenario={(updated) => handleUpdateCurrentEvent(updated)}\\n          onClose={() => setShowTradeoffModal(false)}\\n        />\\n      )}\\n\\n      {showNewEventModal && (\\n        <EventWizardModal\\n          onEventCreated={handleEventCreated}\\n          onClose={() => setShowNewEventModal(false)}\\n        />\\n      )}\\n    </div>\\n  );\\n}\\n\", \"Description\":\"Connect Home Hub, AI Advisor Chat, session management, dynamic budget changing, and vendor ledger injection in App.tsx\", \"Overwrite\":true, \"TargetFile\":\"/src/App.tsx\", \"toolAction\":\"Writing updated App.tsx\", \"toolSummary\":\"Connect Home Hub and AI Chat in App.tsx\"}"
      thinking_signature: "\022\256\v\n\253\v\001i\024}\023\245\203\302\302\177\304\030L\024-!\357F\361\263\026\2138:\0061\347\354>\347\033\327\006t\003a\367\302Y7>G\341\n\tEt\337\016lv\353H:\005{\205\v\202\300E\300\213\332}K7\372S \302C\377F\266\246\205\3043\t\377\305\211q*\346\353C\277\b\302weU`(HeS\216\236\273w\017\"\367\201\\\026~\2052=\325?\177\317A\326\342n\"\2152\r\177?\305\336W,\361\337s{\250\v\177\243\247\220\247\000CmO\264s\022M\327tm\261\355[#\2512\a\023-\\2\024d\'\233\215\206F\024i\354\3559N\221mD1y\214\002IL\235\255\334\354\f\246}L\\\356\210-\325\253\250\003\034G\325\022`\257\vLo\202y\264O\177\250f\2005\252z\027\206\276\313\377\006\302a:5\275zx\rc\337dE\351\322@\367\366\370\2143X\004\337\257\372\352\315\366\304\256\375\027\244\261p\302r:\2549\002\276\371B\030\276\034#\271l\027L\240\242Ze\242t\360z\024\030|;\212\f\335\273\244o\356N(,\265\v\362\004\006\361\251\311I\025\215YaE~\362\200|)\317\"\240\211=\017\336\323P\367b\333\346n2\2068\345SP\275\211\240!s$?b\346\226#\344\204\311\240/\313\276\214\205\032\b~\344\215J\316\232\323\304\303\341\313C\b\303\236\2769\210\230\336\263\247\336\325y\340\\?v\317\342\261T\324\364>\335 D\000\260\3457\017\317\332|\251\332\n\003\246#J7\022CAy\264\311\240M5\252\353\366+\001_2\252\204++<\230\245\322\255R\316\t\364\342\345\004\366\rd\t\350\334v\374:$\341\002^q\000G\265\274\361(w\225w\271n\277\rL\222\362\023C\323\n\2241\325C\340}\n\211\337\241\225\300loh\202EP\275\004D\246\234\276}\310\342\232!\234\3261\265\206\217\240u\230.4\177\344_|=(Z\350\326TZ\016\254\336\246\345a\037\035%^ j[\374\\]\251<\360\311\344\322g\326_\266a\344\236\243\363{\021\353\350k1E\264\264#\206\257h\375W\221\312\362\'\315\\\2754\362\345\326f(\024\226\bT\225\213\3133<\031\203\274\253}w9\366\304\336E}\331F\210lO\211\256\337\006\206\217\323;\352T\200\345\232\016\220\261\f\033j\240\204w\253\306\221W\355J\367/1\333\216\227B\316g\300g\251\274\266\035\205fC\376=v!SH\222W\351\216Sr\360\360;^,\321\034\032\211\0245\v\334u\375`B\204\206\227WK\226\345\v\376\354\023J\240\200k\317\027\317\355\347ul\231\223\026\312c\215\t:\317\364\221W\270\316\244\017\237i\025\267\214\300\021G\v\363x@\300\"C\310d\354\332\266}A\"\b\256\372n\002\023\005\227\3645\2144\255,\177\322\305M\243\242\201\211\256p\266\207`-\025\361\332\264\357\271\347\374\332\305\245lH8\253O:\366\237\235\310\221H6T\263I&F\364B1j\366$\357\004ZS\245\375\377jOull\037\266\276\215\316\364\033y\212<\235\364\037\371\320\263\036\327\016M\317:\241\257\345\006(\252h\376\f6J\267,I\" \004+\362\254\t\025{\231\0255\031\203\254\255w\222X\225\322\004\371?\244\250>W\341v+>F\307\'{\023\300\254\252I\343\364?-%\245\";G\031\250N\360\240\331M\177_+\236v%\246\020\017\262\0000_\202\244<\340{\356}\340\265\342OIi\334\356\350u\225d\b\"\251:\365/f\033l\357\350\t\345{\267c\261\001?i\324;&\213h>b\363\255\372X\346\267\304\353\267\341\2443\375\336W\206\236,\300\334\211\222\226L\264\337\252\265\277\227\342\260~\273e\364~\266\"\351\336\214:+f\313\023%a\002\332[\253}\366\216W9\177\277\205\230\001$\200\335\023WF\325lI\266\361\035F\333$\016\037\251\332/\345\250\262\252\363\212<\005\303\267\356\272\314\253KY\253>\255\300\230d\334\v\213\022\0376-\323\222\326;\241\207Bx\356\275\370\216\030\216\023\004\303\351\000>\227\364\336\345\341\374\370pc\251\231\035z,\241\266\027\031\275\310\230\364T\212\033_=\276\356_]\332\nF\223D\025\227\203&{\003\320\203\376S\365\002\334;k\373\203`\220\313\244\301\276D\303\322\376\251%\250\267l\005\347\246ie 31@ \034\375\375jF\362\260\255\254n\200\312\310\213\263\331R\000\225\221\361P\366|\243\262\245\350\021\301\236\363\021<\245\222\375\301K\251\300z {\360\342\322\226\236\\\373P\234\236\233\333\267\240\344]sW\026\017\225w\232\310\366\242\374_k\202\330\006\202\320u\302\336H^FM\250\330\202$Q\336\377\211\023i\217\342\307\231\002\256P\213?\237t;\342\220\315M\321\321l\273\377\333\246s\351\343\201T\276%\346\232\027\'\\9\341\276\340\3458\000Pw\207\v.\313\237\bk5\211\f[#\240\366\324\277\315\205b\022\022\2161\335\231\027\037\243\344?D\206rEl\017\236\016\206\376\215\2233m\337\f\222\254\023q\003\267L\3