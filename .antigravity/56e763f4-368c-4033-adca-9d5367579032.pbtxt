              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "- **Warm Ivory Background:** `#FAF7F0`"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "- **White/Cream Card Surfaces:** `#FFFDF9`"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "- **Forest Olive (Primary Accent):** `#405B43`"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "- **Sage Green (Supportive Elements):** `#DCE6D6`"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "- **Marigold (Celebration Highlights):** `#E7A83E`"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "- **Terracotta (Secondary Accent):** `#C76F50`"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "- **Espresso Body Text:** `#302F28`"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "- **Muted Text:** `#77756B`"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "- **Soft Borders:** `#E7E0D3`"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "- **Typography:** Playfair Display for editorial display headings + Plus Jakarta Sans / Inter for clean interface readability."
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "---"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "## 3. Architecture & Core Tech Stack"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "- **Frontend:** React 19 SPA, TypeScript, Tailwind CSS v4, Lucide React icons, Recharts for financial analytics, Canvas Confetti."
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "- **PWA Capabilities:** Complete Progressive Web App with `manifest.json`, Service Worker offline caching, home screen install prompt banner, and shortcut actions."
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "- **Backend Server:** Node.js Express server running on port 3000 with Vite middleware in development mode (`tsx server.ts`)."
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "- **AI & LLM Integration:** Official Google Gen AI SDK (`@google/genai`) using `gemini-2.5-flash` with structured JSON output schemas and robust deterministic demo fallbacks."
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "- **Testing:** Native Node.js test runner (`node:test`, `node:assert`) with automated unit tests for ripple propagation, capacity checks, and budget balance."
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "---"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "## 4. Key Feature Modules"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "### A. Overview Dashboard"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "- Living readiness indicator computed deterministically from task completion % and confirmed vendor quotes."
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "- Financial velocity metrics: Total Budget, Planned Allocations, Committed Contracts, Paid Advances, and Cost Per Guest."
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "- Multi-function preview cards with date, time, venue, capacity, and attire themes."
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "- Active Ripple Simulation impact banner with direct links to rebalance trade-offs."
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "### B. Living Event Twin & Ripple Engine (Signature Feature)"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "- Multi-tier visual dependency network:"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  - *Tier 1: Upstream Drivers* (Guest Headcount, Auspicious Dates)."
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  - *Tier 2: Direct Dependents* (Venue Capacity, Royal Rasoi Catering, Return Favors)."
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  - *Tier 3: Downstream Aggregators* (Total Event Budget, Task Lead-times)."
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "- **Preset 1 (Guest Increase):** Attendance jumps from 180 to 220. Recalculates catering lines, flags Heritage Lawns capacity alert (max 200 pax; 20 over capacity)."
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "- **Preset 2 (Date Shift):** Moves wedding dates 2 weeks earlier. Recalculates all dependent task deadlines; flags overdue lead times."
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "- **Preset 3 (Vendor Price Spike):** Applies +20% price hike on catering and florals; recalculates budget overrun and prompts Trade-off Simulator."
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "- **Node Inspector:** Click any node to inspect causality, trigger source, authoritative data source, and recommended next actions."
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "### C. Priority Compass & Trade-off Simulator"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "- Rank and lock core family priorities (Food Quality, Photography, Hospitality, Decor, Guest Count, Convenience)."
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "- Generates 3 genuinely distinct mathematical scenarios:"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  1. **Protect the Feast:** Preserves live stations & 4-course banquet; trims decor and drone package to save \342\202\27126,000."
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  2. **Protect the Guest List:** Retains full 220 guests; switches to digital cloud photo galleries and mobilizes contingency reserve to save \342\202\27128,500."
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  3. **Protect the Memories:** Preserves 4K cinema teaser and heirloom album; re-purposes morning florals for evening stage and trims dessert courses to save \342\202\27125,000."
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "- Click **\"Apply to Living Plan\"** to update budget allocations, line items, and provenance records across all views."
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "### D. Vendor Quote X-Ray & Clarification Drafter"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "- Paste quotation text or upload vendor proposals."
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "- Structured line-item breakdown with unit prices, subtotals, GST, and terms."
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "- Explicit detection of omissions (\"Overtime charges not mentioned \342\200\224 ask vendor\", \"Staff gratuity not specified\")."
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "- Multilingual clarification inquiry generator (English, Hindi, Gujarati) with one-click copy draft."
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "### E. Adaptive Timeline & Calendar Export"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "- Multi-function filtering (Mehendi, Sangeet, Vedic Wedding, Reception, Combined)."
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "- Lead-time recomputation when dates shift."
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "- Task completion toggles directly feeding into overall Event Readiness."
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "- Downloadable standard `.ics` iCalendar file for syncing with Google Calendar or Apple Calendar."
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "### F. Multi-Event Versatility"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "- Supports Weddings, Milestone Birthdays, Engagements, Family Reunions, and Community Galas."
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "- Preloaded with two full celebrations:"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  1. *Aarav & Meera\'s Wedding Celebration* (Multi-function Indian wedding)."
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  2. *Arjun\'s 30th Milestone Rooftop Soiree* (Milestone birthday template)."
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "---"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "## 5. Requirement-to-Feature Mapping (PromptWars Challenge 5)"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "| Challenge Requirement | Bandobast Implementation | Verification |"
