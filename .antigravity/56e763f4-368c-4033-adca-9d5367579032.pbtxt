        target_content: "import React from \'react\';\nimport { \n  LayoutDashboard, \n  Wallet, \n  GitFork, \n  FileSpreadsheet, \n  CalendarClock, \n  SlidersHorizontal,\n  Sparkles,\n  HeartHandshake\n} from \'lucide-react\';\n\nexport type NavigationTab = \n  | \'overview\' \n  | \'budget\' \n  | \'ripple\' \n  | \'quotes\' \n  | \'timeline\' \n  | \'priorities\';\n\ninterface SidebarProps {\n  currentTab: NavigationTab;\n  onSelectTab: (tab: NavigationTab) => void;\n  isOpenMobile: boolean;\n  onCloseMobile: () => void;\n  activeSimulationCount: number;\n}\n\nexport const Sidebar: React.FC<SidebarProps> = ({\n  currentTab,\n  onSelectTab,\n  isOpenMobile,\n  onCloseMobile,\n  activeSimulationCount\n}) => {\n  const navItems = [\n    {\n      id: \'overview\' as NavigationTab,\n      label: \'Overview\',\n      icon: LayoutDashboard,\n      badge: null\n    },\n    {\n      id: \'budget\' as NavigationTab,\n      label: \'Budget Studio\',\n      icon: Wallet,\n      badge: null\n    },\n    {\n      id: \'ripple\' as NavigationTab,\n      label: \'Ripple Engine\',\n      icon: GitFork,\n      badge: activeSimulationCount > 0 ? `${activeSimulationCount} active` : \'Signature\'\n    },\n    {\n      id: \'quotes\' as NavigationTab,\n      label: \'Vendor Quotes\',\n      icon: FileSpreadsheet,\n      badge: \'Quote X-Ray\'\n    },"
        replacement_content: "import React from \'react\';\nimport { \n  Home,\n  LayoutDashboard, \n  MessageSquare,\n  Wallet, \n  GitFork, \n  FileSpreadsheet, \n  CalendarClock, \n  SlidersHorizontal,\n  Sparkles,\n  HeartHandshake\n} from \'lucide-react\';\n\nexport type NavigationTab = \n  | \'home\'\n  | \'chat\'\n  | \'overview\' \n  | \'budget\' \n  | \'ripple\' \n  | \'quotes\' \n  | \'timeline\' \n  | \'priorities\';\n\ninterface SidebarProps {\n  currentTab: NavigationTab;\n  onSelectTab: (tab: NavigationTab) => void;\n  isOpenMobile: boolean;\n  onCloseMobile: () => void;\n  activeSimulationCount: number;\n}\n\nexport const Sidebar: React.FC<SidebarProps> = ({\n  currentTab,\n  onSelectTab,\n  isOpenMobile,\n  onCloseMobile,\n  activeSimulationCount\n}) => {\n  const navItems = [\n    {\n      id: \'home\' as NavigationTab,\n      label: \'Home Hub\',\n      icon: Home,\n      badge: \'Hub\'\n    },\n    {\n      id: \'chat\' as NavigationTab,\n      label: \'AI Advisor Chat\',\n      icon: MessageSquare,\n      badge: \'Gen AI\'\n    },\n    {\n      id: \'overview\' as NavigationTab,\n      label: \'Event Overview\',\n      icon: LayoutDashboard,\n      badge: null\n    },\n    {\n      id: \'budget\' as NavigationTab,\n      label: \'Budget Studio\',\n      icon: Wallet,\n      badge: null\n    },\n    {\n      id: \'ripple\' as NavigationTab,\n      label: \'Ripple Engine\',\n      icon: GitFork,\n      badge: activeSimulationCount > 0 ? `${activeSimulationCount} active` : \'Signature\'\n    },\n    {\n      id: \'quotes\' as NavigationTab,\n      label: \'Vendor Quotes\',\n      icon: FileSpreadsheet,\n      badge: \'Quote X-Ray\'\n    },"
