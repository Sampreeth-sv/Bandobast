  planner_response {
    thinking: "**Expanding Event Types**\n\nI\'m now focused on expanding Bandobast to support multiple event types beyond weddings. My priority is building `src/components/EventWizardModal.tsx` for a more flexible and reusable celebration and event-planning platform. I\'m incorporating options for engagements, birthdays, anniversaries, and family gatherings.\n\n\n"
    tool_calls {
      id: "call_545474"
      name: "write_to_file"
      arguments_json: "{\"CodeContent\":\"import React, { useState } from \'react\';\\nimport { CelebrationEvent, EventType, EventFunction, BudgetCategory } from \'../types\';\\nimport { X, Sparkles, Calendar, MapPin, Users, IndianRupee, Heart, Cake, Users2, Landmark, HelpCircle, Check } from \'lucide-react\';\\n\\ninterface EventWizardModalProps {\\n  onEventCreated: (newEvent: CelebrationEvent) => void;\\n  onClose: () => void;\\n}\\n\\nexport const EventWizardModal: React.FC<EventWizardModalProps> = ({\\n  onEventCreated,\\n  onClose\\n}) => {\\n  const [eventType, setEventType] = useState<EventType>(\'wedding\');\\n  const [eventName, setEventName] = useState(\'\');\\n  const [occasion, setOccasion] = useState(\'\');\\n  const [location, setLocation] = useState(\'Jaipur, Rajasthan\');\\n  const [startDate, setStartDate] = useState(\'2026-12-05\');\\n  const [endDate, setEndDate] = useState(\'2026-12-07\');\\n  const [budget, setBudget] = useState(250000);\\n  const [guestCount, setGuestCount] = useState(150);\\n  const [primaryPriority, setPrimaryPriority] = useState(\'Food Quality & Catering\');\\n\\n  const eventTypes: { type: EventType; label: string; icon: any; defaultOccasion: string; defaultFunctions: string[] }[] = [\\n    {\\n      type: \'wedding\',\\n      label: \'Wedding\',\\n      icon: Heart,\\n      defaultOccasion: \'Multi-Function Traditional Indian Wedding\',\\n      defaultFunctions: [\'Mehendi & Sangeet\', \'Vedic Wedding Ceremony\', \'Grand Gala Reception\']\\n    },\\n    {\\n      type: \'birthday\',\\n      label: \'Birthday Bash\',\\n      icon: Cake,\\n      defaultOccasion: \'Milestone Birthday Party\',\\n      defaultFunctions: [\'Evening Cocktails & Cake Cutting\']\\n    },\\n    {\\n      type: \'engagement\',\\n      label: \'Engagement / Roka\',\\n      icon: Sparkles,\\n      defaultOccasion: \'Ring Ceremony & Family Celebration\',\\n      defaultFunctions: [\'Ring Exchange & Dinner Banquet\']\\n    },\\n    {\\n      type: \'community\',\\n      label: \'Community / Festival\',\\n      icon: Landmark,\\n      defaultOccasion: \'Diwali / Navratri Cultural Gala\',\\n      defaultFunctions: [\'Cultural Performances & Community Feast\']\\n    },\\n    {\\n      type: \'reunion\',\\n      label: \'Family Reunion\',\\n      icon: Users2,\\n      defaultOccasion: \'Annual Family Get-Together\',\\n      defaultFunctions: [\'Day Picnic & Evening Campfire Dinner\']\\n    },\\n    {\\n      type: \'custom\',\\n      label: \'Custom Event\',\\n      icon: HelpCircle,\\n      defaultOccasion: \'Special Celebration\',\\n      defaultFunctions: [\'Main Gathering\']\\n    }\\n  ];\\n\\n  const handleSelectType = (selected: EventType) => {\\n    setEventType(selected);\\n    const config = eventTypes.find(t => t.type === selected);\\n    if (config) {\\n      setOccasion(config.defaultOccasion);\\n      if (!eventName || eventName.includes(\'Celebration\') || eventName.includes(\'Wedding\')) {\\n        setEventName(\\n          selected === \'wedding\' ? \'Karan & Pooja Wedding\' :\\n          selected === \'birthday\' ? \\\"Vikram\'s 40th Birthday\\\" :\\n          selected === \'community\' ? \'Community Diwali Mela\' :\\n          selected === \'engagement\' ? \'Ananya & Rohan Ring Ceremony\' :\\n          \'Family Golden Jubilee\'\\n        );\\n      }\\n    }\\n  };\\n\\n  const handleCreate = (e: React.FormEvent) => {\\n    e.preventDefault();\\n\\n    const selectedConfig = eventTypes.find(t => t.type === eventType)!;\\n    const initialFunctions: EventFunction[] = selectedConfig.defaultFunctions.map((name, i) => ({\\n      id: `func-${Date.now()}-${i}`,\\n      name,\\n      date: startDate,\\n      time: \'06:00 PM - 10:30 PM\',\\n      venueName: `${location} Banquet Grounds`,\\n      venueCapacity: Math.round(guestCount * 1.25),\\n      guestCount: guestCount,\\n      attireTheme: \'Festive Traditional\',\\n      description: `Primary celebration slot for ${name}`,\\n      color: i === 0 ? \'#405B43\' : i === 1 ? \'#E7A83E\' : \'#C76F50\'\\n    }));\\n\\n    // Generate event-specific default categories\\n    let initialCategories: BudgetCategory[] = [];\\n    if (eventType === \'wedding\') {\\n      initialCategories = [\\n        {\\n          id: `cat-cat-${Date.now()}`,\\n          name: \'Catering & Dining\',\\n          iconName: \'Utensils\',\\n          color: \'#405B43\',\\n          plannedAmount: Math.round(budget * 0.40),\\n          committedAmount: 0,\\n          paidAmount: 0,\\n          isMustPreserve: true,\\n          notes: \'Multi-course regional feasts & live stations\',\\n          lineItems: [\\n            {\\n              id: `li-c1-${Date.now()}`,\\n              categoryId: `cat-cat-${Date.now()}`,\\n              name: \'Per-Head Catering Service\',\\n              unitCost: Math.round((budget * 0.40) / guestCount),\\n              unitType: \'per_guest\',\\n              quantity: guestCount,\\n              plannedAmount: Math.round(budget * 0.40),\\n              committedAmount: 0,\\n              paidAmount: 0,\\n              isProtected: true,\\n              provenance: {\\n                source: \'user_entered\',\\n                calculationBasis: `Initial budget allocation: \342\202\271${Math.round((budget * 0.40) / guestCount)}/guest`,\\n                verified: true,\\n                lastUpdated: new Date().toISOString().split(\'T\')[0]\\n              }\\n            }\\n          ]\\n        },\\n        {\\n          id: `cat-ven-${Date.now()}`,\\n          name: \'Venue & Property\',\\n          iconName: \'Building\',\\n          color: \'#E7A83E\',\\n          plannedAmount: Math.round(budget * 0.25),\\n          committedAmount: 0,\\n          paidAmount: 0,\\n          isMustPreserve: false,\\n          notes: \'Lawn and banquet space rentals\',\\n          lineItems: []\\n        },\\n        {\\n          id: `cat-dec-${Date.now()}`,\\n          name: \'Decoration & Florals\',\\n          iconName: \'Flower2\',\\n          color: \'#C76F50\',\\n          plannedAmount: Math.round(budget * 0.18),\\n          committedAmount: 0,\\n          paidAmount: 0,\\n          isMustPreserve: false,\\n          notes: \'Floral mandap, stage & entrance lighting\',\\n          lineItems: []\\n        },\\n        {\\n          id: `cat-pho-${Date.now()}`,\\n          name: \'Photography & Cinema\',\\n          iconName: \'Camera\',\\n          color: \'#405B43\',\\n          plannedAmount: Math.round(budget * 0.12),\\n          committedAmount: 0,\\n          paidAmount: 0,\\n          isMustPreserve: false,\\n          notes: \'Candid photographer & video coverage\',\\n          lineItems: []\\n        },\\n        {\\n          id: `cat-con-${Date.now()}`,\\n          name: \'Contingency Reserve\',\\n          iconName: \'ShieldAlert\',\\n          color: \'#77756B\',\\n          plannedAmount: Math.round(budget * 0.05),\\n          committedAmount: 0,\\n          paidAmount: 0,\\n          isMustPreserve: false,\\n          notes: \'Buffer reserve for sudden price adjustments\',\\n          lineItems: []\\n        }\\n      ];\\n    } else {\\n      // Birthday / Community / Get-Together template\\n      initialCategories = [\\n        {\\n          id: `cat-food-${Date.now()}`,\\n          name: \'Food & Refreshments\',\\n          iconName: \'Utensils\',\\n          color: \'#405B43\',\\n          plannedAmount: Math.round(budget * 0.50),\\n          committedAmount: 0,\\n          paidAmount: 0,\\n          isMustPreserve: true,\\n          notes: \'Buffet grazing, drinks, and cake\',\\n          lineItems: [\\n            {\\n              id: `li-b1-${Date.now()}`,\\n              categoryId: `cat-food-${Date.now()}`,\\n              name: \'Buffet & Appetizers\',\\n              unitCost: Math.round((budget * 0.50) / guestCount),\\n              unitType: \'per_guest\',\\n              quantity: guestCount,\\n              plannedAmount: Math.round(budget * 0.50),\\n              committedAmount: 0,\\n              paidAmount: 0,\\n              isProtected: true,\\n              provenance: {\\n                source: \'user_entered\',\\n                calculationBasis: `Initial allocation: \342\202\271${Math.round((budget * 0.50) / guestCount)}/guest`,\\n                verified: true,\\n                lastUpdated: new Date().toISOString().split(\'T\')[0]\\n              }\\n            }\\n          ]\\n        },\\n        {\\n          id: `cat-ven-${Date.now()}`,\\n          name: \'Venue & Audio Setup\',\\n          iconName: \'Building\',\\n          color: \'#E7A83E\',\\n          plannedAmount: Math.round(budget * 0.25),\\n          committedAmount: 0,\\n          paidAmount: 0,\\n          isMustPreserve: false,\\n          notes: \'Rental & sound equipment\',\\n          lineItems: []\\n        },\\n        {\\n          id: `cat-dec-${Date.now()}`,\\n          name: \'Theme Styling & Favors\',\\n          iconName: \'Sparkles\',\\n          color: \'#C76F50\',\\n          plannedAmount: Math.round(budget * 0.15),\\n          committedAmount: 0,\\n          paidAmount: 0,\\n          isMustPreserve: false,\\n          notes: \'Balloons, signage & guest gifts\',\\n          lineItems: []\\n        },\\n        {\\n          id: `cat-res-${Date.now()}`,\\n          name: \'Contingency Reserve\',\\n          iconName: \'ShieldAlert\',\\n          color: \'#77756B\',\\n          plannedAmount: Math.round(budget * 0.10),\\n          committedAmount: 0,\\n          paidAmount: 0,\\n          isMustPreserve: false,\\n          notes: \'Overrun safety buffer\',\\n          lineItems: []\\n        }\\n      ];\\n    }\\n\\n    const newEvent: CelebrationEvent = {\\n      id: `evt-${Date.now()}`,\\n      name: eventName || \'New Celebration\',\\n      occasion: occasion || \'Celebration\',\\n      eventType,\\n      location,\\n      startDate,\\n      endDate,\\n      totalBudget: budget,\\n      guestCount,\\n      contingencyReserve: Math.round(budget * 0.08),\\n      readinessScore: 45,\\n      functions: initialFunctions,\\n      categories: initialCategories,\\n      tasks: [\\n        {\\n          id: `t-${Date.now()}-1`,\\n          name: \'Lock RSVP & Confirmed Guest Count\',\\n          description: \'Establish finalized attendance for catering bookings\',\\n          dueDate: startDate,\\n          originalDueDate: startDate,\\n          category: \'Coordination\',\\n          status: \'in_progress\',\\n          priority: \'critical\',\\n          dependencies: []\\n        },\\n        {\\n          id: `t-${Date.now()}-2`,\\n          name: \'Review & Confirm Vendor Quotes\',\\n          description: \'Compare quotations via Bandobast Quote X-Ray\',\\n          dueDate: startDate,\\n          originalDueDate: startDate,\\n          category: \'Vendors\',\\n          status: \'not_started\',\\n          priority: \'high\',\\n          dependencies: [`t-${Date.now()}-1`]\\n        }\\n      ],\\n      quotes: [],\\n      priorities: [\\n        {\\n          id: \'p-1\',\\n          label: primaryPriority,\\n          rank: 1,\\n          locked: true,\\n          description: \'Primary designated core priority\'\\n        },\\n        {\\n          id: \'p-2\',\\n          label: \'Guest Comfort & Experience\',\\n          rank: 2,\\n          locked: false,\\n          description: \'Seating, welcome drinks and seamless hospitality\'\\n        },\\n        {\\n          id: \'p-3\',\\n          label: \'Theme Decoration & Aesthetic\',\\n          rank: 3,\\n          locked: false,\\n          description: \'Lighting, staging and atmosphere\'\\n        }\\n      ],\\n      protectedRequirements: [\\n        `${primaryPriority} must remain protected during budget trade-offs`\\n      ],\\n      activeSimulation: {\\n        activePreset: \'none\',\\n        guestCountDelta: 0,\\n        dateDaysShift: 0,\\n        vendorIncreasePercent: 0\\n      },\\n      createdAt: new Date().toISOString(),\\n      updatedAt: new Date().toISOString()\\n    };\\n\\n    onEventCreated(newEvent);\\n    onClose();\\n  };\\n\\n  return (\\n    <div className=\\\"fixed inset-0 z-50 flex items-center justify-center p-4 bg-black/55 backdrop-blur-xs\\\">\\n      <div \\n        className=\\\"bg-[#FFFDF9] border border-[#E7E0D3] rounded-3xl max-w-2xl w-full p-6 sm:p-8 shadow-2xl relative animate-in fade-in zoom-in-95 duration-150 max-h-[92vh] overflow-y-auto\\\"\\n        role=\\\"dialog\\\"\\n        aria-modal=\\\"true\\\"\\n      >\\n        <button\\n          onClick={onClose}\\n          className=\\\"absolute top-5 right-5 text-[#77756B] hover:text-[#302F28] p-1.5 rounded-xl hover:bg-[#FAF7F0]\\\"\\n          aria-label=\\\"Close\\\"\\n        >\\n          <X className=\\\"w-5 h-5\\\" />\\n        </button>\\n\\n        <div className=\\\"flex items-center gap-3 mb-4\\\">\\n          <div className=\\\"w-10 h-10 rounded-2xl bg-[#405B43] text-[#FAF7F0] flex items-center justify-center shadow-xs\\\">\\n            <Sparkles className=\\\"w-5 h-5 text-[#E7A83E]\\\" />\\n          </div>\\n          <div>\\n            <h2 className=\\\"font-serif text-2xl font-bold text-[#302F28]\\\">Configure New Celebration</h2>\\n            <p className=\\\"text-xs text-[#77756B]\\\">Set up a living event twin for weddings, birthdays, reunions, or community galas.</p>\\n          </div>\\n        </div>\\n\\n        <form onSubmit={handleCreate} className=\\\"space-y-5\\\">\\n          {/* 1. Event Type Selector */}\\n          <div>\\n            <label className=\\\"block text-xs font-semibold text-[#405B43] uppercase tracking-wider mb-2\\\">\\n              Select Celebration Template\\n            </label>\\n            <div className=\\\"grid grid-cols-2 sm:grid-cols-3 gap-2.5\\\">\\n              {eventTypes.map((t) => {\\n                const Icon = t.icon;\\n                const isSelected = eventType === t.type;\\n                return (\\n                  <button\\n                    key={t.type}\\n                    type=\\\"button\\\"\\n                    onClick={() => handleSelectType(t.type)}\\n                    className={`p-3 rounded-2xl border text-left flex items-center gap-2.5 transition-all cursor-pointer ${\\n                      isSelected\\n                        ? \'bg-[#EDF3EC] border-[#405B43] text-[#405B43] font-semibold ring-1 ring-[#405B43]\'\\n                        : \'bg-[#FAF7F0] border-[#E7E0D3] text-[#302F28] hover:border-[#405B43]/50\'\\n                    }`}\\n                  >\\n                    <Icon className={`w-4 h-4 ${isSelected ? \'text-[#405B43]\' : \'text-[#77756B]\'}`} />\\n                    <span className=\\\"text-xs\\\">{t.label}</span>\\n                  </button>\\n                );\\n              })}\\n            </div>\\n          </div>\\n\\n          {/* 2. Basic Details */}\\n          <div className=\\\"grid grid-cols-1 sm:grid-cols-2 gap-4\\\">\\n            <div>\\n              <label className=\\\"block text-xs font-medium text-[#302F28] mb-1\\\">Celebration Name</label>\\n              <input\\n                type=\\\"text\\\"\\n                required\\n                value={eventName}\\n                onChange={(e) => setEventName(e.target.value)}\\n                placeholder=\\\"e.g. Aarav & Meera Wedding\\\"\\n                className=\\\"w-full px-3.5 py-2.5 rounded-xl border border-[#E7E0D3] bg-[#FAF7F0] text-xs text-[#302F28] focus:outline-hidden focus:border-[#405B43]\\\"\\n              />\\n            </div>\\n\\n            <div>\\n              <label className=\\\"block text-xs font-medium text-[#302F28] mb-1\\\">Occasion / Theme</label>\\n              <input\\n                type=\\\"text\\\"\\n                required\\n                value={occasion}\\n                onChange={(e) => setOccasion(e.target.value)}\\n                className=\\\"w-full px-3.5 py-2.5 rounded-xl border border-[#E7E0D3] bg-[#FAF7F0] text-xs text-[#302F28] focus:outline-hidden focus:border-[#405B43]\\\"\\n              />\\n            </div>\\n          </div>\\n\\n          {/* 3. Location & Dates */}\\n          <div className=\\\"grid grid-cols-1 sm:grid-cols-3 gap-3\\\">\\n            <div>\\n              <label className=\\\"block text-xs font-medium text-[#302F28] mb-1\\\">Location</label>\\n              <div className=\\\"relative\\\">\\n                <MapPin className=\\\"w-3.5 h-3.5 text-[#77756B] absolute left-3 top-3\\\" />\\n                <input\\n                  type=\\\"text\\\"\\n                  required\\n                  value={location}\\n                  onChange={(e) => setLocation(e.target.value)}\\n                  className=\\\"w-full pl-9 pr-3 py-2.5 rounded-xl border border-[#E7E0D3] bg-[#FAF7F0] text-xs text-[#302F28]\\\"\\n                />\\n              </div>\\n            </div>\\n\\n            <div>\\n              <label className=\\\"block text-xs font-medium text-[#302F28] mb-1\\\">Start Date</label>\\n              <div className=\\\"relative\\\">\\n                <Calendar className=\\\"w-3.5 h-3.5 text-[#77756B] absolute left-3 top-3\\\" />\\n                <input\\n                  type=\\\"date\\\"\\n                  required\\n                  value={startDate}\\n                  onChange={(e) => setStartDate(e.target.value)}\\n                  className=\\\"w-full pl-9 pr-3 py-2.5 rounded-xl border border-[#E7E0D3] bg-[#FAF7F0] text-xs text-[#302F28]\\\"\\n                />\\n              </div>\\n            </div>\\n\\n            <div>\\n              <label className=\\\"block text-xs font-medium text-[#302F28] mb-1\\\">End Date</label>\\n              <div className=\\\"relative\\\">\\n                <Calendar className=\\\"w-3.5 h-3.5 text-[#77756B] absolute left-3 top-3\\\" />\\n                <input\\n                  type=\\\"date\\\"\\n                  required\\n                  value={endDate}\\n                  onChange={(e) => setEndDate(e.target.value)}\\n                  className=\\\"w-full pl-9 pr-3 py-2.5 rounded-xl border border-[#E7E0D3] bg-[#FAF7F0] text-xs text-[#302F28]\\\"\\n                />\\n              </div>\\n            </div>\\n          </div>\\n\\n          {/* 4. Budget & Guests */}\\n          <div className=\\\"grid grid-cols-1 sm:grid-cols-2 gap-4\\\">\\n            <div>\\n              <label className=\\\"block text-xs font-medium text-[#302F28] mb-1\\\">Total Target Budget (\342\202\271)</label>\\n              <div className=\\\"relative\\\">\\n                <IndianRupee className=\\\"w-3.5 h-3.5 text-[#77756B] absolute left-3 top-3\\\" />\\n                <input\\n                  type=\\\"number\\\"\\n                  required\\n                  min=\\\"10000\\\"\\n                  step=\\\"5000\\\"\\n                  value={budget}\\n                  onChange={(e) => setBudget(parseInt(e.target.value) || 0)}\\n                  className=\\\"w-full pl-9 pr-3 py-2.5 rounded-xl border border-[#E7E0D3] bg-[#FAF7F0] text-xs font-mono font-bold text-[#405B43]\\\"\\n                />\\n              </div>\\n              <p className=\\\"text-[10px] text-[#77756B] mt-1\\\">\342\202\271{budget.toLocaleString(\'en-IN\')} planned pool</p>\\n            </div>\\n\\n            <div>\\n              <label className=\\\"block text-xs font-medium text-[#302F28] mb-1\\\">Initial Expected Guests</label>\\n              <div className=\\\"relative\\\">\\n                <Users className=\\\"w-3.5 h-3.5 text-[#77756B] absolute left-3 top-3\\\" />\\n                <input\\n                  type=\\\"number\\\"\\n                  required\\n                  min=\\\"5\\\"\\n                  max=\\\"5000\\\"\\n                  value={guestCount}\\n                  onChange={(e) => setGuestCount(parseInt(e.target.value) || 1)}\\n                  className=\\\"w-full pl-9 pr-3 py-2.5 rounded-xl border border-[#E7E0D3] bg-[#FAF7F0] text-xs font-mono font-bold text-[#302F28]\\\"\\n                />\\n              </div>\\n              <p className=\\\"text-[10px] text-[#77756B] mt-1\\\">Est. \342\202\271{Math.round(budget / (guestCount || 1)).toLocaleString(\'en-IN\')} / guest</p>\\n            </div>\\n          </div>\\n\\n          {/* 5. Core Priority Selection */}\\n          <div>\\n            <label className=\\\"block text-xs font-medium text-[#302F28] mb-1\\\">\\n              Protected Priority (Must Not Be Reduced During Trade-offs)\\n            </label>\\n            <select\\n              value={primaryPriority}\\n              onChange={(e) => setPrimaryPriority(e.target.value)}\\n              className=\\\"w-full px-3.5 py-2.5 rounded-xl border border-[#E7E0D3] bg-[#FAF7F0] text-xs text-[#302F28]\\\"\\n            >\\n              <option value=\\\"Food Quality & Catering\\\">Food Quality & Authentic Catering</option>\\n              <option value=\\\"Guest Headcount Scale\\\">Preserving Full Guest Count (No Cuts)</option>\\n              <option value=\\\"Photography & Cinema\\\">Cinematic Photography & Film Documentation</option>\\n              <option value=\\\"Theme Decoration & Atmosphere\\\">Visual Decor, Lighting & Floral Aesthetics</option>\\n              <option value=\\\"Hospitality & Convenience\\\">Guest Experience, Shuttles & Comfort</option>\\n            </select>\\n          </div>\\n\\n          {/* Buttons */}\\n          <div className=\\\"flex items-center justify-end gap-3 pt-4 border-t border-[#E7E0D3]\\\">\\n            <button\\n              type=\\\"button\\\"\\n              onClick={onClose}\\n              className=\\\"py-2.5 px-4 rounded-xl border border-[#E7E0D3] text-[#302F28] hover:bg-[#FAF7F0] text-xs font-medium\\\"\\n            >\\n              Cancel\\n            </button>\\n            <button\\n              type=\\\"submit\\\"\\n              className=\\\"py-2.5 px-5 rounded-xl bg-[#405B43] hover:bg-[#324734] text-[#FAF7F0] text-xs font-bold shadow-sm transition-transform hover:scale-[1.02] cursor-pointer\\\"\\n            >\\n              Initialize Event Twin\\n            </button>\\n          </div>\\n        </form>\\n      </div>\\n    </div>\\n  );\\n};\\n\", \"Description\":\"Create EventWizardModal supporting multiple celebration types with tailored templates\", \"Overwrite\":true, \"TargetFile\":\"/src/components/EventWizardModal.tsx\", \"toolAction\":\"Writing EventWizardModal.tsx\", \"toolSummary\":\"Create event wizard modal\"}"
      thinking_signature: "\022\323\b\n\320\b\001i\024}\023e\375\373%\335\300\334j\366Ig|0\315\327MM\'\352D.\250\033\331M\200\275D\211wi\350F\312\027E\037: DP\"\276%G3\233\302\275\216\177 \250\240\224\225\354e\200\346\367\017,zP\245\f\206\'a\030\220tw\2228\245\264j\264k6\306\253s\004z\345\376\210\3414\346KK\223\335#\352\240k\203\233\350\025\310\227\237\330\230i@\244W\023\256%\236\006uJ\016\337l\354\035\241k\371qqf\324\037e\032\255s\027\226\263o\232\333\035A\341\234\254Y!\221K5(\314w\307\3624t\315$d\364\2606X\"\0059\215\225p\037\021@\304\277<\205\315S%~\246Ojl\367[\231\275\376Y&\226\306\n\027 \v\r\211\327\302\347\225\357\375<\rA\231\315\307\370\245\364\3670\\\211\306M\2347E<\314-\3323\035\247C\252)\v\354\300\354I\002z\356\324\022\026\035ISl+m\210\217\3202\321|\265\312\\\362.^\r\0066\250\307*\0031&\0323\002\375`\026\003\333K\346v\004\22718\247\352\204L@O}e\'\346U\340\'\253joZ\336U\324zs\232L\237\222\276,\243[)w\322\346&\206\326\023\362ia\307\271\353\016I\367\032\376\030\321~~\366\300T\237\351\313M\261\2270\270@\366z\002\235]\207\031\025\23111~\327\252\305+\370\0331W\212B\270\233HBs\177\254\347\210\vx\317N\030Z+n\245w\363 CB\a\376\310\024\2401w3;\353D\241\263$C\371\275HRD\001\367(dE\226\316\002O8\a\355\243vw\356\373\036\221\226M\341\361=!\277UM\232\035\372\355\353j\265\256\321\311]\314\354\261:\n\034\215\f~\002\310r\276\177\035F\371\332\311d\303\242\364\347\022\005\003\020\004\334\037\256\373\373o\214I\206y\022\034\373\231\263\023\201\334\245\030\273\273\365\253v\rn7\025\252b\376\326\024d\334|\301=\'\317\330\336\250D\2651*\0354@0M\265\236\215\003!\221q\211y\321\223T\205\314\344gc\342\323*\327\221\212eplc\213Y\031S\370M{W\234\257\260\212v\225B9\311\306\236\334\\\355U\233\311n\1775\317\276+t~Hp\201\315\327\201R\370\303\245m\235\f\020\371\200c\353\231\216%\360\330\202x\215\035\347\206\275\353\231\t;\005\252\n&\331t\234\\\214\2317P\230^V\340;MTx%\323\360\347\002\257P\024&\347Sn\261\340\002\365\246\336r\343+\277\277\351p\376\275\036\332\026eb\320\302\315z_\363\225\340)\362\036r\310j\237/2\317\020\310\250;\213\253]\376\266[\234`\332\230\303R\272\262=\243\365\340\244\341\025_\023\034\033l0\363\303\216\021\313\372L.\342\335\201\205\256\277\346\235\235<\f\001\030\301#TR\000\210\2670\237\314\034T\225\'\312\2116\217%\026\aM\223B\2475\345#K\273\366\232\362\312\365\275\200\r;\027}\026\315\254\300j1\241\215\200\341\333Cbo\305\263\325+\365\321Qr\313\312\036=6\261\211a\034\230`=\t\225<\355\030\246\335h\016\244\2328@&\3107Z\022\324\343\037l\225\351\341E#\354\002&\376\030\255\255v\a\305\255i\316T\2779\307\033\320r\235\207\033\305\313\356\315\225\266\275\223`\306\201pY\327\321\205\220\\Jv4E|\322m\321\335:\017U[\323\a\326\277Y\346j\341\"Ghy\357\361\005\257\017\350\024@g~\270\305\360a\245{&&^ *\356\f\017@a\340-_\203\037\246\024\267\270\367Y\3218\331^\025QLh)]\336\337\365\350\325d_\300\257:\331w\001\243\246\377\343\023\250l\324\276\035\204\230\347&\312Q\037\205JN\314\033\2234Z8\360\202\362\232KX\320T\004\226J\262\215\031`\025\035\357\276\201\2736\2573<8#I\335FJ\242f\277\036\237\016\301 g\347\377\310\353\351s\201\325\214\227\361,H\231K\234x \352/FZ\207\342)\022-\030\360\0345ns\350\200\204\373aB\262<Z\204y\263%\364"
